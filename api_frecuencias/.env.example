# Copie este archivo como .env y ajuste los valores. El .env real NO se versiona (está en .gitignore).
# Todas las variables se describen en docs/despliegue.md (tabla «Variables de entorno»).

# ---------------------------------------------------------------- base de resultados propia (servicio «db»)
# Esquema ai_frecuencias en PostgreSQL 14 + PostGIS. Cambie la clave antes del primer «docker compose up».
POSTGRES_DB=ai_frecuencias
POSTGRES_USER=sobusa
POSTGRES_PASSWORD=cambie_esta_clave_local
DB_PUERTO_HOST=5433
API_PUERTO_HOST=8000

# URL que usa la API. Desde el equipo anfitrión (venv) el puerto es 5433;
# dentro de docker compose la API usa db:5432 (lo fija docker-compose.yml).
DATABASE_URL=postgresql+psycopg://sobusa:cambie_esta_clave_local@localhost:5433/ai_frecuencias

# ---------------------------------------------------------------- fuente operacional (solo lectura)
# parquet (por defecto, sin red, reproducible) o postgres.
FUENTE=parquet
# Solo si FUENTE=postgres: URL de un usuario con privilegios SELECT (lector_ia). Se abre en transacción
# READ ONLY con statement_timeout. Déjela vacía en el repositorio.
FUENTE_DATABASE_URL=
FUENTE_STATEMENT_TIMEOUT_MS=30000
# Lectura que alimenta el ciclo con FUENTE=postgres. Solo demanda_segmentos está soportada de punta a punta
# (timbradas_segmentos del trigger de Extreme convertidas a demanda horaria; pasajeros = suma de numeropasajeros de
# los viajes válidos, la definición del modelo); otro valor detiene el arranque con un error que lo explica.
# FUENTE_PROCESO: proceso (operador) de la tabla «Procesos» de Extreme cuyas rutas se leen; por omisión sobusa,
# * = todos los procesos de la base (la consulta une rutas, «Procesos» y estacionalidades_anio, §11.2).
# FUENTE_SOLAPE_MIN: ventana de solape de la marca de agua, en minutos.
FUENTE_TABLA=demanda_segmentos
FUENTE_PROCESO=sobusa
FUENTE_SOLAPE_MIN=15
# /api/v1/catalogos: auto (réplica si hay URL; si no, archivos) | replica | archivos. URL de solo lectura propia
# (vacía = FUENTE_DATABASE_URL), exportaciones Parquet (vacío = ../../datos), reporte de flota y caché (s).
CATALOGOS_FUENTE=auto
CATALOGOS_DATABASE_URL=
CATALOGOS_DATOS_DIR=
CATALOGOS_FLOTA_CSV=
CATALOGOS_CACHE_S=300

# Carpeta con los datos del proyecto (Parquet/JSON y modelos). Vacío = ./datos
DATA_DIR=
TZ=America/Bogota

# ---------------------------------------------------------------- operación de la API
# ENTORNO: local | pruebas | demo | produccion. Swagger (/docs y /openapi.json) solo fuera de producción;
# DOCS_HABILITADOS=true/false lo fuerza; sin definir = según ENTORNO (no la deje vacía: no es un booleano).
ENTORNO=local
# DOCS_HABILITADOS=true
MAX_REINTENTOS=3
REANUDAR_EJECUCIONES=true
LOG_NIVEL=INFO

# Cola de trabajos en PostgreSQL (RNF-005): hilos consumidores por réplica (0 = la ejecución se procesa en la misma
# petición que la crea), reserva en segundos (si la réplica muere, otra retoma el trabajo al vencer) y sondeo de la
# cola. TRABAJADOR_ID: identidad estable de la réplica (vacío = nombre del equipo o contenedor); con dos réplicas en
# el MISMO equipo, dele un valor distinto a cada una.
TRABAJADORES=1
LEASE_SEGUNDOS=30
SONDEO_COLA_SEGUNDOS=1
TRABAJADOR_ID=
# Planificador interno (§7.2, APScheduler, zona America/Bogota): ejecución diaria y revisión semanal del
# reentrenamiento. Qué decide la revisión lo fija la política versionada de threshold_config
# (politica.decidir_reentreno: días de datos nuevos validados, degradación, deriva o cobertura; GET
# /api/v1/monitoring/policy), no una variable de entorno. Cron estándar de 5 campos (1 = lunes).
# Sin definir: apagado al correr con el venv y encendido en docker compose (también en el modo integrado).
# Descomente para forzarlo.
# PLANIFICADOR_HABILITADO=true
PLAN_EJECUCION_CRON=15 5 * * *
PLAN_REENTRENAMIENTO_CRON=0 4 * * 1

# Motor de inferencia (§9.2): sklearn (joblib, por omisión) u onnx (ONNX Runtime; los modelo_{punto,p10,p90}.onnx
# del modelo activo y su SHA-256 están en el manifiesto; scripts/exportar_onnx.py los regenera)
MOTOR_INFERENCIA=sklearn
# Las dos variables siguientes se leen del entorno del proceso: docker compose las pasa desde este archivo; con el
# venv, defínalas en la consola antes de arrancar uvicorn.
# MODELO_PLAN: pronóstico con el que se calcula la respuesta del reto (§20: la foto que guardan el ciclo diario y
# POST /api/v1/respuesta/calcular). activo (por omisión) = P10/P50/P90 hora por hora del modelo activo del registro,
# para cualquier fecha con variables; E12 = el pronóstico precalculado del experimento 12 del informe académico (solo
# 2025, como comparación). La trazabilidad nombra la fuente del pronóstico, el modelo y la calibración. El plan del
# día que guarda el ciclo usa siempre el modelo activo; GET /api/v1/recommendations/plan elige con pronostico=activo|E12.
MODELO_PLAN=activo
# INFERENCIA_SERIE: serie con la que se arman las variables del modelo cuando la llamada no trae una sesión de la base
# (RF-013, §9.5). validada = el Parquet empaquetado con las horas VALIDADAS de demanda_observada encima: el proceso
# abre su propia sesión de solo lectura y, si la base no responde, usa la serie empaquetada y lo deja en el log.
# Vacía = solo la serie empaquetada (lo que usan los scripts de evidencia y las pruebas unitarias).
INFERENCIA_SERIE=validada

# Notificaciones SIMULADAS (correo y WhatsApp): solo dejan el registro en notification_log.
NOTIFICACIONES_CANALES=correo,whatsapp
NOTIFICACIONES_SEVERIDAD=critica
NOTIF_CORREO_DESTINATARIOS=
NOTIF_CORREO_REMITENTE=
NOTIF_WHATSAPP_NUMEROS=

# ---------------------------------------------------------------- secretos (valores propios en el .env local)
# §18 «Exposición de datos»: secreto del HMAC-SHA256 que seudonimiza al conductor en las alertas (cnd_<24 hex>).
# Genere uno propio:  python -c "import secrets; print(secrets.token_hex(32))"
# Sin secreto la alerta guarda conductor = NULL; nunca se guarda el nombre ni el documento.
SEUDONIMO_SECRETO=cambie_este_secreto_por_64_caracteres_hexadecimales_al_azar

# Autenticación por X-API-Key con roles operador < analista < admin (§7.2). Encendida por omisión.
# Las claves NO van en el repositorio: genere cada una con
#   python scripts/crear_api_key.py --rol admin --usuario ana
#   (o dentro del contenedor: docker compose -p sobusa_api run --rm --no-deps api python scripts/crear_api_key.py ...)
# y pegue aquí solo la entrada con el hash, p. ej. API_KEYS={"<sha256>": {"usuario": "ana", "rol": "admin"}}
# (varias entradas en el mismo objeto JSON), o defina una clave por rol (API_KEY_OPERADOR/ANALISTA/ADMIN).
AUTH_HABILITADA=true
API_KEYS=
API_KEY_OPERADOR=
API_KEY_ANALISTA=
API_KEY_ADMIN=
# /metrics sin clave para el scrape de Prometheus en la red interna; false = exige X-API-Key de cualquier rol.
METRICAS_PUBLICAS=true
# Clientes (scripts/demo_ciclo_api.py, scripts/medir_rendimiento.py, k6, tablero Dash): la clave que envían en
# X-API-Key y la URL de la API.
SOBUSA_API_KEY=
SOBUSA_API_URL=http://127.0.0.1:8000
# Clave de rol analista reservada para el tablero Dash local (la lee el tablero; nunca se versiona).
SOBUSA_API_KEY_DASH=

# Circuit breaker (RNF-010): fallos de conexión seguidos para abrir y segundos hasta el ensayo semiabierto.
CIRCUITO_FUENTE_FALLOS_MAX=3
CIRCUITO_FUENTE_REINICIO_S=60
CIRCUITO_NOTIF_FALLOS_MAX=5
CIRCUITO_NOTIF_REINICIO_S=120

# Trazas OpenTelemetry (RNF-006): ninguno | consola | otlp. Con otlp, OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTADOR=ninguno
OTEL_SERVICE_NAME=api-frecuencias
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------- réplica de la base operacional (perfil integracion)
# Solo valores de EJEMPLO: ponga claves propias en el .env local. Las de lector_ia y escritor_ia se fijan al crear el
# volumen (replica/initdb/30_roles.sh).
OPERACIONAL_PASSWORD=cambie_clave_dba_replica
LECTOR_IA_PASSWORD=cambie_clave_lector_ia
ESCRITOR_IA_PASSWORD=cambie_clave_escritor_ia
OPERACIONAL_PUERTO_HOST=5434
# Puerto de la API en modo integrado (docker-compose.integracion.yml) y planificador en ese modo: encendido por
# omisión, porque es el modo que lee la base operacional real (false lo apaga, por ejemplo en una réplica de pruebas)
API_INTEGRADA_PUERTO_HOST=8302
PLANIFICADOR_HABILITADO_INTEGRADO=true
# Correcciones de la réplica (1 = aplicar). E1/E2 se leen al crear el volumen; H1 la aplica scripts/replica_cargar.py
REPLICA_ERRATA_E1=1
REPLICA_ERRATA_E2=1
REPLICA_ARMONIZAR_ESTACIONALIDADES=1
