# Copie este archivo como .env y ajuste los valores. El .env real NO se versiona.
# Base de resultados PROPIA (esquema ai_frecuencias), servicio «db» de docker compose.
POSTGRES_DB=ai_frecuencias
POSTGRES_USER=sobusa
POSTGRES_PASSWORD=cambie_esta_clave_local
DB_PUERTO_HOST=5433
API_PUERTO_HOST=8000

# URL que usa la API. Desde el equipo anfitrión (venv) el puerto es 5433;
# dentro de docker compose la API usa db:5432 (lo fija docker-compose.yml).
DATABASE_URL=postgresql+psycopg://sobusa:cambie_esta_clave_local@localhost:5433/ai_frecuencias

# Fuente de las tablas operacionales: parquet (por defecto, sin red, reproducible) o postgres.
FUENTE=parquet
# Solo si FUENTE=postgres: URL de un usuario con privilegios SELECT. Se abre en transacción
# READ ONLY con statement_timeout. Déjela vacía en el repositorio.
FUENTE_DATABASE_URL=
FUENTE_STATEMENT_TIMEOUT_MS=30000

# Carpeta con los datos del proyecto (Parquet/JSON). Vacío = ./datos
DATA_DIR=
TZ=America/Bogota

# Operación de la API
ENTORNO=local
DOCS_HABILITADOS=true
MAX_REINTENTOS=3
REANUDAR_EJECUCIONES=true
LOG_NIVEL=INFO

# Notificaciones SIMULADAS (correo y WhatsApp): solo dejan el registro en notification_log.
NOTIFICACIONES_CANALES=correo,whatsapp
NOTIFICACIONES_SEVERIDAD=critica
NOTIF_CORREO_DESTINATARIOS=
NOTIF_CORREO_REMITENTE=
NOTIF_WHATSAPP_NUMEROS=
